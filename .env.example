# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Send the bot /start right after it starts: the
# first person to do so becomes its owner, and the bot answers nobody else.
BOT_TOKEN=your_telegram_bot_token
# Optional: your Telegram user id (from @userinfobot) pins the owner or takes
# the bot over; it wins over the owner stored by the first /start.
ADMIN_CHAT_ID=

# ── Platforms: fill in the ones you want, leave the rest empty ──────────────
# Telegram channel (@username or -100… id). The bot must be an admin there.
TELEGRAM_CHANNEL_ID=

# YouTube Data API v3 key + channel id (UC…). Both or neither.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Instagram: the @username of a professional (Creator/Business) account. The
# follower count comes from the official Instagram API with the system-user
# token your Meta app issues (by default it does not expire; the bot shows its
# term and reminds you a week before it ends): send it with /igtoken in the
# bot or set it here. See docs/connect/instagram.en.md.
INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn profile URL. Followers are read with the 'li_at' cookie of a
# logged-in browser session — set it with /setcookie in the bot (tracks its
# age and warns before it expires) or here. Without a cookie you can still
# enter the number by hand. See the LinkedIn note in README.
LINKEDIN_PROFILE_URL=
LINKEDIN_LI_AT=
# After N days a manually entered LinkedIn number is marked as stale
LINKEDIN_STALE_DAYS=7

# ── Language ────────────────────────────────────────────────────────────────
# Chat language of every screen, report and alert: ru or en. Empty: your
# Telegram's language decides at the first /start (unless ADMIN_CHAT_ID is set,
# then Russian) — Russian stays Russian, so do Uzbek, Kazakh, Kyrgyz, Tajik and
# Belarusian, any other becomes English. ⚙️ Настройки → «🗣 Язык / Language» switches it later,
# and the choice made in the chat wins over this variable.
BOT_LANG=

# ── Schedule ────────────────────────────────────────────────────────────────
# Data is collected daily at this time; the report is pushed on REPORT_DOW.
# Time and days are in TIMEZONE, an IANA zone name (Europe/Moscow, Asia/Almaty…);
# empty — the zone of BOT_LANG: Europe/Moscow for ru, UTC for en.
# These are defaults: once you set the time, days or zone in ⚙️ Настройки, the bot
# keeps them, and a TIMEZONE changed later doesn't move them. Invalid values stop
# the bot at startup. Older names still work: REPORT_TZ for TIMEZONE (read when
# TIMEZONE is empty), REPORT_HOUR_UTC for REPORT_HOUR.
TIMEZONE=
# REPORT_TZ=
REPORT_HOUR=8
REPORT_MINUTE=0
# Report day(s): sat, mon, mon-fri, mon,thu, daily (or *).
REPORT_DOW=sat
# 1 = a one-liner instead of the full report when nothing changed
QUIET_IF_NO_CHANGE=0

# ── Storage ─────────────────────────────────────────────────────────────────
# Keep it on a persistent volume (docker-compose mounts ./data).
DB_PATH=data/followers.db

# ── Security emails (optional) ──────────────────────────────────────────────
# The simple way needs nothing here: a separate Gmail or Yandex mailbox for the
# bot, connected in the chat (🔌 Подключения → ✉️ Письма безопасности) with an
# app password. For the advanced, your own mail-worker that receives the
# forwarded notifications (mail-worker/README.md): its URL and the TOKEN secret
# set there. Both or neither; a worker set in the chat wins.
SECURITY_MAIL_URL=
SECURITY_MAIL_TOKEN=

# ── Comments of the channel (optional) ──────────────────────────────────────
# A Claude API key (console.anthropic.com): the bot then looks at every comment
# in the channel's discussion group and sends you a card with delete / ban
# buttons for prohibited content. Nothing is deleted without your tap. The bot
# must be an admin of the group with the rights to delete messages and ban
# members. The key can also be sent in the chat (💬 Комментарии канала →
# «🔑 Прислать ключ Claude»); the chat wins. Empty here and in the chat = off.
ANTHROPIC_API_KEY=
# The model that classifies comments (default claude-opus-5-5).
COMMENTS_MODEL=
# The group is found through the channel (its linked discussion group); set a
# chat id (-100…) to name it explicitly.
COMMENTS_CHAT_ID=
# Checks per day (UTC): a spam wave must not become an unbounded API bill. The
# bot says once a day when the limit is reached and leaves the rest unchecked.
# Default 300; 0 = no limit. The buttons on 💬 Комментарии канала win.
COMMENTS_DAILY_LIMIT=

# ── Optional integrations ───────────────────────────────────────────────────
# Dead man's switch: pinged after every successful daily collect, e.g. a
# https://healthchecks.io check with a 1-day period (a plain GET), or a
# TofsDevOps task (➕ Добавить → ⏰ Бот или задача по расписанию, «раз в сутки»: its
# /api/heartbeat/… address) — then the ping is a POST that also carries a line
# per network for the TofsDevOps main screen. Easier from the chat: 🔌
# Подключения → ⏱ Сторож, with a live test ping; an address set there wins and
# this variable is the fallback. Empty = off (the bot offers it once).
HEALTHCHECK_URL=

# Push the latest counts to your own site after every collect:
# POST SITE_INGEST_URL with "Authorization: Bearer SOCIALBOT_INGEST_TOKEN" and
# JSON {"telegram": N, "youtube": N, "instagram": N, "linkedin": N, "updatedAt": "…Z"}
# (enabled platforms only). Both empty = off.
SITE_INGEST_URL=
SOCIALBOT_INGEST_TOKEN=

# ── Updates ─────────────────────────────────────────────────────────────────
# The bot says «🔄 Бот обновился» after every deploy, whatever this is set to.
# 1 also warns when the newest commit failed to deploy and once a week reports
# known vulnerabilities and Dependabot PRs waiting for you — while the monitor
# «Для разработчика» is on in /modules (off on a new install, on for a bot that
# ran before 1.13.0); 0 turns those off whatever the monitor says.
UPDATE_WATCH=1
# Railway provides the commit and the repository itself. Elsewhere set the
# repository (owner/name) and build with --build-arg APP_COMMIT=$(git rev-parse HEAD).
GITHUB_REPOSITORY=
# Optional, only lifts GitHub's anonymous rate limit (60 requests/hour per IP).
GITHUB_TOKEN=
