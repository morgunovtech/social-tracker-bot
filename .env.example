# Telegram
BOT_TOKEN=your_telegram_bot_token
ADMIN_CHAT_ID=your_telegram_user_id
TELEGRAM_CHANNEL_ID=@raschet7

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# LinkedIn
# Preferred: paste 'li_at' cookie from a logged-in browser (DevTools → Application → Cookies → linkedin.com → li_at)
# When set, bot fetches followers automatically without RapidAPI.
LINKEDIN_LI_AT=
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-username/
# After N days, manual LinkedIn entry is marked as stale in reports
LINKEDIN_STALE_DAYS=7
# RapidAPI fallback (used if LINKEDIN_LI_AT is empty or fetch failed)
RAPIDAPI_KEY=

# Schedule (UTC). Default: Saturday 08:00 UTC = 13:00 Tashkent
REPORT_HOUR_UTC=8
REPORT_MINUTE=0
# Day of week: sat, mon, mon-fri, mon,thu, * (daily)
REPORT_DOW=sat
# 1 = skip push when day/week deltas are all zero
QUIET_IF_NO_CHANGE=0

# Database
DB_PATH=data/followers.db

# Site push (about-me-page) — sends finalized counts to the public site.
# Use the SAME value as the Cloudflare secret SOCIALBOT_INGEST_TOKEN on the site.
# Leave empty to disable the push.
SOCIALBOT_INGEST_TOKEN=
# Override only if the site endpoint changes (default is production):
# SITE_INGEST_URL=https://s.morgunov.tech/api/ingest/subscribers
