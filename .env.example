# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather and YOUR Telegram user id (from @userinfobot):
# only this user can use the bot.
BOT_TOKEN=your_telegram_bot_token
ADMIN_CHAT_ID=your_telegram_user_id

# ── Platforms: fill in the ones you want, leave the rest empty ──────────────
# Telegram channel (@username or -100… id). The bot must be an admin there.
TELEGRAM_CHANNEL_ID=@your_channel

# YouTube Data API v3 key + channel id (UC…). Both or neither.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# LinkedIn profile URL. Followers are read with the 'li_at' cookie of a
# logged-in browser session — set it with /setcookie in the bot (tracks its
# age and warns before it expires) or here. Without a cookie you can still
# enter the number by hand. See the LinkedIn note in README.
LINKEDIN_PROFILE_URL=
LINKEDIN_LI_AT=
# After N days a manually entered LinkedIn number is marked as stale
LINKEDIN_STALE_DAYS=7

# ── Schedule (UTC) ──────────────────────────────────────────────────────────
# Data is collected daily at this time; the report is pushed on REPORT_DOW.
REPORT_HOUR_UTC=8
REPORT_MINUTE=0
# Report day(s): sat, mon, mon-fri, mon,thu, daily (or *). Invalid values stop the bot at startup.
REPORT_DOW=sat
# 1 = a one-liner instead of the full report when nothing changed
QUIET_IF_NO_CHANGE=0

# ── Storage ─────────────────────────────────────────────────────────────────
# Keep it on a persistent volume (docker-compose mounts ./data).
DB_PATH=data/followers.db

# ── Optional integrations ───────────────────────────────────────────────────
# Dead man's switch: pinged (GET) after every successful daily collect, e.g.
# a https://healthchecks.io check with a 1-day period. Empty = off.
HEALTHCHECK_URL=

# Push the latest counts to your own site after every collect:
# POST SITE_INGEST_URL with "Authorization: Bearer SOCIALBOT_INGEST_TOKEN" and
# JSON {"telegram": N, "youtube": N, "linkedin": N, "updatedAt": "…Z"}
# (enabled platforms only). Both empty = off.
SITE_INGEST_URL=
SOCIALBOT_INGEST_TOKEN=

# ── Updates ─────────────────────────────────────────────────────────────────
# The bot says «🔄 Бот обновился» after a deploy, warns when the newest commit
# failed to deploy, and once a week reports known vulnerabilities and
# Dependabot PRs waiting for you. 0 = off.
UPDATE_WATCH=1
# Railway provides the commit and the repository itself. Elsewhere set the
# repository (owner/name) and build with --build-arg APP_COMMIT=$(git rev-parse HEAD).
GITHUB_REPOSITORY=
# Optional, only lifts GitHub's anonymous rate limit (60 requests/hour per IP).
GITHUB_TOKEN=
